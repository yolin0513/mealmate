{
  "name": "mealmate",
  "version": "0.1.0",
  "description": "MealMate 家庭三餐規劃 — 免帳號、純前端、離線可用的一週菜單與購物清單 PWA。營養數字為估計值僅供參考，不是醫療或營養處方。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pwa",
    "offline",
    "traditional-chinese",
    "meal-planning",
    "shopping-list"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs 5190",
    "build-foods": "node scripts/build-foods.mjs",
    "build-recipes": "node scripts/build-recipes.mjs",
    "icons": "node scripts/make-icons.mjs",
    "bump": "node scripts/bump-version.mjs",
    "datatest": "node scripts/datatest.mjs",
    "aliastest": "node scripts/aliastest.mjs",
    "unittest": "node scripts/unittest.mjs",
    "edutest": "node scripts/edutest.mjs",
    "recipetest": "node scripts/recipetest.mjs",
    "copytest": "node scripts/copytest.mjs",
    "shelltest": "node scripts/shelltest.mjs",
    "mutationtest": "node scripts/mutationtest.mjs",
    "test": "node scripts/datatest.mjs && node scripts/aliastest.mjs && node scripts/unittest.mjs && node scripts/edutest.mjs && node scripts/recipetest.mjs && node scripts/copytest.mjs && node scripts/shelltest.mjs && node scripts/mutationtest.mjs"
  },
  "devDependencies": {
    "puppeteer": "23.11.1"
  }
}
