#!/bin/sh
# pre-commit：突變跑到一半被中斷時，不讓壞檔被 commit 進去（Dispatch 2026-10-02 指示 8-1）。
# 安裝：npm run hooks:install（＝ git config core.hooksPath scripts/hooks；設定存在這份工作區的 .git/config，新 clone 要再裝一次）。
# 這是第一道、提早擋；推送閘門 scripts/pushgate.sh 的第零關之零（回 7）照舊留著——hook 可以被 --no-verify 跳過、
# 新 clone 也可能還沒裝，真正擋住「推出去」的是推送閘門。兩邊查的是同兩處紀錄：
#   1. scripts/.mutation-pending.json（執行器改壞原始碼之前寫的還原紀錄；在 .gitignore 裡，git status 看不到）
#   2. 帳本 scripts/mutation-ledger.json 的 inflight（不是 null 就是有一條改壞了還沒收尾）
# 紀錄讀不出檔名也擋：讀不出來不是「沒有紀錄」（§5.13）。驗法：doctest「pre-commit hook」H1–H6，突變 HK ×2。
cd "$(git rev-parse --show-toplevel)" || { echo "【擋下：pre-commit】找不到 repo 的根目錄，判斷不了有沒有還原紀錄"; exit 1; }
PENDINGF="scripts/.mutation-pending.json"
LEDGERF="scripts/mutation-ledger.json"
if [ -e "$PENDINGF" ]; then
  prel="$(grep -o '"rel":"[^"]*"' "$PENDINGF")"
  echo "【擋下：突變的還原紀錄】$PENDINGF 還在：突變跑到一半被中斷，${prel:-（紀錄讀不出檔名）} 可能還是改壞的版本。先跑一次 node scripts/mutationtest.mjs --dry-run 讓它還原（或照紀錄人工還原、確認 git diff），再 commit"
  exit 1
fi
if [ -e "$LEDGERF" ] && grep -q -F '"inflight": {' "$LEDGERF"; then
  echo "【擋下：突變的還原紀錄】帳本 $LEDGERF 記著一條改壞了還沒收尾的突變（inflight），先跑一次 node scripts/mutationtest.mjs --dry-run 核對兩處紀錄，再 commit"
  exit 1
fi
exit 0
