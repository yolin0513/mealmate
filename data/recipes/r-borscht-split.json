  "steps": [
    { "stage": "base", "type": "prep", "text": "番茄切塊，洋蔥、胡蘿蔔、馬鈴薯切丁，高麗菜切片、芹菜切段；杏鮑菇切丁；牛腩切丁，冷水下鍋汆燙後洗淨。" },
    { "stage": "base", "type": "cook", "text": "大鍋下油，洋蔥炒軟，加番茄與番茄醬炒到番茄化開，放胡蘿蔔、馬鈴薯、高麗菜、芹菜與 1500 毫升水煮滾，小火煮 15 分鐘。" },
    { "stage": "split", "type": "split", "text": "把蔬菜湯分成兩鍋，素食那鍋依吃素的人數分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：放杏鮑菇丁，小火煮 10 分鐘，加鹽調味。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：放汆燙好的牛腩丁，小火燉 35 分鐘到牛腩軟，加鹽調味。" }
  ]
