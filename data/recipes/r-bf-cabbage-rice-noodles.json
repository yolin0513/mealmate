    { "food": "高麗菜", "label": "高麗菜（切絲）", "grams": 250, "track": "base" },
    { "food": "胡蘿蔔", "label": "胡蘿蔔（切絲）", "grams": 60, "track": "base" },
    { "food": "香菇", "label": "新鮮香菇（切絲）", "grams": 80, "track": "base" },
    { "food": "豆腐皮", "label": "豆皮（切絲）", "grams": 60, "track": "base" },
    { "food": "油", "label": "油", "grams": 20, "track": "base", "pantry": true },
    { "food": "醬油", "label": "醬油", "grams": 20, "track": "base", "pantry": true },
