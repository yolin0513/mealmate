  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "米粉用溫水泡 10 分鐘到軟，剪短、瀝乾；高麗菜、胡蘿蔔、香菇、豆皮都切絲。" },
    { "stage": "base", "type": "cook", "text": "鍋熱下油，炒香菇、胡蘿蔔、豆皮 2 分鐘，再下高麗菜炒軟。" },
    { "stage": "base", "type": "cook", "text": "加醬油和 150 毫升水煮滾，放入米粉，用筷子挑散拌炒到湯汁吸乾。" },
    { "stage": "base", "type": "cook", "text": "加鹽、白胡椒粉拌勻起鍋。" }
  ]
