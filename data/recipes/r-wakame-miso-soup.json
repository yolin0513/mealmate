{
  "id": "r-wakame-miso-soup",
  "name": "海帶芽金針菇味噌湯",
  "role": "soup",
  "servings": 4,
  "time": 15,
  "method": "soup",
  "vegMode": "nativeVeg",
  "texture": "soft",
  "season": [],
  "ingredients": [
    { "food": "海帶芽", "label": "乾海帶芽", "grams": 10, "track": "base" },
    { "food": "金針菇", "label": "金針菇（切段）", "grams": 150, "track": "base" },
    { "food": "嫩豆腐", "label": "嫩豆腐（切小丁）", "grams": 200, "track": "base" },
    { "food": "昆布", "label": "昆布（煮高湯）", "grams": 10, "track": "base" },
    { "food": "青蔥", "label": "蔥花（吃全素不含五辛的可以不放）", "grams": 15, "track": "base" },
    { "food": "味噌", "label": "味噌", "grams": 50, "track": "base", "pantry": true }
  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "昆布用濕布擦過；海帶芽泡水 5 分鐘瀝乾；金針菇切段、嫩豆腐切小丁、青蔥切花。" },
    { "stage": "base", "type": "cook", "text": "鍋放 1000 毫升水與昆布，小火煮到快滾時取出昆布，放入金針菇與豆腐丁煮 3 分鐘。" },
    { "stage": "base", "type": "serve", "text": "放海帶芽，味噌用一勺熱湯化開倒回鍋中，關火撒蔥花，不要再煮滾。" }
  ]
}
