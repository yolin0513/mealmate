  "steps": [
    { "stage": "base", "type": "prep", "text": "雞腿剁塊汆燙洗淨；馬鈴薯、胡蘿蔔、洋蔥切塊，蒜頭拍碎，辣椒切段。" },
    { "stage": "base", "type": "cook", "text": "鍋下油，蒜頭與雞塊中火炒到表面變色，加醬油與糖翻炒上色。" },
    { "stage": "base", "type": "cook", "text": "加入馬鈴薯、胡蘿蔔、洋蔥與 500 毫升水，煮滾後轉小火蓋鍋燉 25 分鐘。" },
    { "stage": "base", "type": "cook", "text": "開蓋放辣椒，中火收汁到醬汁略稠、馬鈴薯邊緣微微化開。" }
