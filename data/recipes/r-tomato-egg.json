  "ingredients": [
    { "food": "牛番茄", "label": "牛番茄（切塊）", "grams": 450, "track": "base" },
    { "food": "雞蛋", "label": "雞蛋", "grams": 220, "track": "base" },
    { "food": "青蔥", "label": "青蔥（可省略）", "grams": 15, "track": "base" },
    { "food": "油", "label": "沙拉油", "grams": 20, "track": "base", "pantry": true },
