  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "番茄切成一口大小的塊；雞蛋打散加一小撮鹽；青蔥切段。" },
    { "stage": "base", "type": "cook", "text": "鍋熱後下一半的油，倒入蛋液，用鍋鏟輕推成大塊嫩蛋，八分熟就先盛出。" },
    { "stage": "base", "type": "cook", "text": "同一鍋下剩下的油，番茄塊中火炒到出水變軟，加鹽和糖調味。" },
    { "stage": "base", "type": "cook", "text": "把蛋倒回鍋裡，和番茄拌炒半分鐘，起鍋前撒蔥段。" }
