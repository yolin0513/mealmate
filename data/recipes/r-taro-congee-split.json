  "id": "r-taro-congee-split",
  "name": "芋頭鹹粥／芋頭香菇粥",
  "role": "breakfast",
  "servings": 4,
  "splitServings": { "veg": 1, "meat": 3 },
  "time": 40,
  "method": "porridge",
  "vegMode": "splittable",
