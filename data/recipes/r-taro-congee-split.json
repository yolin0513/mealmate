  "season": [],
  "includesStaple": true,
  "alliumOptional": true,
  "ingredients": [
    { "food": "白米", "label": "白米（生）", "grams": 160, "track": "base", "pantry": true },
    { "food": "芋頭", "label": "芋頭（去皮切小塊）", "grams": 250, "track": "base" },
    { "food": "乾香菇", "label": "乾香菇（4 朵，泡軟切絲）", "grams": 15, "track": "base" },
    { "food": "芹菜", "label": "芹菜（切末）", "grams": 30, "track": "base" },
    { "food": "油", "label": "油", "grams": 10, "track": "base", "pantry": true },
    { "food": "鹽", "label": "鹽", "grams": 5, "track": "base", "pantry": true },
    { "food": "白胡椒粉", "label": "白胡椒粉", "grams": 1, "track": "base", "pantry": true },
    { "food": "油蔥酥", "label": "油蔥酥（可省略）", "grams": 10, "track": "base", "pantry": true },
    { "food": "豆皮", "label": "豆皮（切條）", "grams": 60, "track": "veg" },
    { "food": "豬肉片", "label": "豬肉絲", "grams": 150, "track": "meat" },
    { "food": "蝦米", "label": "蝦米（泡軟）", "grams": 15, "track": "meat" }
  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "米洗淨；芋頭去皮切小塊；香菇泡軟切絲；芹菜切末；豆皮切條；蝦米泡軟；豬肉切絲用一點鹽抓一下。" },
    { "stage": "base", "type": "cook", "text": "鍋熱下油，炒香菇絲與芋頭塊 2 分鐘，加米與 1600 毫升水煮滾，轉小火煮 25 分鐘成粥，中途攪幾次。" },
    { "stage": "split", "type": "split", "text": "粥分成兩鍋，素食那鍋依吃素的人數分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：下豆皮煮 3 分鐘，加鹽、白胡椒粉，撒芹菜末與油蔥酥。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：下蝦米與肉絲煮到肉變白，加鹽、白胡椒粉，撒芹菜末與油蔥酥。" }
  ]
}
