    { "food": "雞蛋", "label": "雞蛋（3 顆）", "grams": 165, "track": "base" },
    { "food": "高麗菜", "label": "高麗菜（切小片）", "grams": 150, "track": "base" },
    { "food": "胡蘿蔔", "label": "胡蘿蔔（切小丁）", "grams": 60, "track": "base" },
    { "food": "玉米粒", "label": "玉米粒", "grams": 80, "track": "base" },
    { "food": "油", "label": "油", "grams": 15, "track": "base", "pantry": true },
