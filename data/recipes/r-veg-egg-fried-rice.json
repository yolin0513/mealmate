  "steps": [
    { "stage": "base", "type": "prep", "text": "高麗菜切小片、胡蘿蔔切小丁、蔥切蔥花；蛋打散；冷飯先用手或飯匙撥鬆。" },
    { "stage": "base", "type": "cook", "text": "鍋熱下一半的油，倒入蛋液炒到半熟就盛起來。" },
    { "stage": "base", "type": "cook", "text": "下另一半的油，炒胡蘿蔔丁 1 分鐘，再下高麗菜、玉米粒炒到高麗菜變軟。" },
    { "stage": "base", "type": "cook", "text": "下白飯炒散炒熱，倒回炒蛋，加鹽、白胡椒粉拌勻，起鍋前撒蔥花。" }
  ]
