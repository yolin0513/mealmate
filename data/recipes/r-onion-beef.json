    { "food": "洋蔥", "label": "洋蔥（切絲）", "grams": 250, "track": "base" },
    { "food": "醬油", "label": "醬油", "grams": 20, "track": "base", "pantry": true },
    { "food": "糖", "label": "糖", "grams": 4, "track": "base", "pantry": true },
