  "steps": [
    { "stage": "base", "type": "prep", "text": "牛肉片用一半的醬油和太白粉抓醃十分鐘；洋蔥切絲。" },
    { "stage": "base", "type": "cook", "text": "鍋熱下一半的油，洋蔥中火炒到軟、邊緣微焦，先盛起。" },
    { "stage": "base", "type": "cook", "text": "同鍋下剩下的油燒到很熱，牛肉片攤平大火快炒到八分熟。" },
    { "stage": "base", "type": "cook", "text": "洋蔥回鍋，加剩下的醬油、糖，翻炒半分鐘，起鍋撒黑胡椒粉。" }
