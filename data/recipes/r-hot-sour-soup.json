  "steps": [
    { "stage": "base", "type": "prep", "text": "木耳泡軟切絲；豆腐、胡蘿蔔切絲；金針菇切段；雞蛋打散。" },
    { "stage": "base", "type": "cook", "text": "鍋放 1000 毫升水煮滾，下胡蘿蔔、木耳、金針菇煮 3 分鐘，再下豆腐絲，加醬油。" },
    { "stage": "base", "type": "cook", "text": "太白粉水勾芡到微稠，蛋液繞圈淋入成蛋花，關火。" },
    { "stage": "base", "type": "serve", "text": "起鍋前才加白醋、白胡椒粉、香油，酸味和辣味才不會煮掉。" }
