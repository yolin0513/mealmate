  "steps": [
    { "stage": "base", "type": "prep", "text": "牛肉片用一半的醬油與太白粉抓醃 10 分鐘；洋蔥切絲、青椒切條、蒜切末。" },
    { "stage": "base", "type": "cook", "text": "鍋下一半的油，洋蔥與青椒大火炒到邊緣微焦、還帶脆度，先盛起。" },
    { "stage": "base", "type": "cook", "text": "同鍋下剩下的油，蒜末爆香，牛肉片攤平大火快炒到八分熟。" },
    { "stage": "base", "type": "cook", "text": "蔬菜回鍋，加蠔油、剩下的醬油與黑胡椒，翻炒半分鐘就起鍋。" }
  ]
