    { "food": "青椒", "label": "青椒（切條）", "grams": 150, "track": "base" },
    { "food": "大蒜", "label": "蒜末", "grams": 10, "track": "base" },
    { "food": "黑胡椒粉", "label": "粗粒黑胡椒", "grams": 3, "track": "base", "pantry": true },
    { "food": "醬油", "label": "醬油", "grams": 20, "track": "base", "pantry": true },
    { "food": "蠔油", "label": "蠔油", "grams": 15, "track": "base", "pantry": true },
