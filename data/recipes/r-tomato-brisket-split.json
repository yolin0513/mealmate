{
  "id": "r-tomato-brisket-split",
  "name": "番茄燉牛腩／番茄燉杏鮑菇",
  "role": "main",
  "servings": 4,
  "splitServings": { "veg": 1, "meat": 3 },
  "time": 60,
  "method": "braise",
  "vegMode": "splittable",
  "texture": "soft",
  "season": [],
  "ingredients": [
    { "food": "番茄", "label": "牛番茄（切塊）", "grams": 400, "track": "base" },
    { "food": "洋蔥", "label": "洋蔥（切丁）", "grams": 200, "track": "base" },
    { "food": "胡蘿蔔", "label": "胡蘿蔔（切塊）", "grams": 150, "track": "base" },
    { "food": "馬鈴薯", "label": "馬鈴薯（切塊）", "grams": 300, "track": "base" },
    { "food": "番茄醬", "label": "番茄醬", "grams": 40, "track": "base", "pantry": true },
    { "food": "鹽", "label": "鹽", "grams": 5, "track": "base", "pantry": true },
    { "food": "油", "label": "沙拉油", "grams": 15, "track": "base", "pantry": true },
    { "food": "杏鮑菇", "label": "杏鮑菇（切滾刀塊）", "grams": 200, "track": "veg" },
    { "food": "牛腩", "label": "牛腩（切塊，燉之前修掉厚的肥肉）", "grams": 450, "track": "meat" }
  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "番茄切塊、洋蔥切丁，胡蘿蔔與馬鈴薯切塊；杏鮑菇切滾刀塊；牛腩切塊，冷水下鍋汆燙後洗淨。" },
    { "stage": "base", "type": "cook", "text": "鍋下油，洋蔥炒軟，下番茄炒到出汁，加番茄醬、胡蘿蔔、馬鈴薯與 800 毫升水煮滾。" },
    { "stage": "split", "type": "split", "text": "把番茄湯底分成兩鍋，素食那鍋依吃素的人數分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：放入杏鮑菇，小火燉 15 分鐘到馬鈴薯鬆軟，加鹽調味。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：放入汆燙好的牛腩，移到電鍋外鍋 2 杯水燉到跳起，牛腩軟了再加鹽調味。" }
  ]
}
