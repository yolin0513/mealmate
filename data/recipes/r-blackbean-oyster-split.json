  "steps": [
    {
      "stage": "base",
      "type": "prep",
      "text": "鮮蚵用薄鹽水輕輕洗過、瀝乾，裹上薄薄一層太白粉；豆腐切塊；豆豉稍微沖水；薑切末、蔥切段。"
    },
    {
      "stage": "base",
      "type": "cook",
      "text": "熱鍋下油，薑末與豆豉小火炒香，加醬油與 150 毫升水煮滾。"
    },
    {
      "stage": "split",
      "type": "split",
      "text": "把豆豉湯汁分成兩鍋，素食那鍋依吃素的人數分。"
    },
    {
      "stage": "veg",
      "type": "cook",
      "text": "素食那鍋：放豆腐塊小火燒五分鐘，撒一半蔥段。"
    },
    {
      "stage": "meat",
      "type": "cook",
      "text": "葷食那鍋：湯汁滾了再下鮮蚵，煮到邊緣捲起就關火（約兩分鐘，久煮會縮），撒剩下的蔥段。"
    }
  ]
