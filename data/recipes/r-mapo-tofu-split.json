{
  "id": "r-mapo-tofu-split",
  "name": "家常麻婆豆腐（可分素葷）",
  "role": "main",
  "servings": 4,
  "time": 25,
  "method": "braise",
  "vegMode": "splittable",
  "texture": "soft",
  "season": [],
  "ingredients": [
    { "food": "板豆腐", "label": "板豆腐（切 2 公分塊）", "grams": 600, "track": "base" },
    { "food": "薑", "label": "薑末", "grams": 10, "track": "base" },
    { "food": "辣豆瓣醬", "label": "辣豆瓣醬", "grams": 30, "track": "base", "pantry": true },
    { "food": "醬油", "label": "醬油", "grams": 10, "track": "base", "pantry": true },
    { "food": "糖", "label": "糖", "grams": 5, "track": "base", "pantry": true },
    { "food": "油", "label": "沙拉油", "grams": 15, "track": "base", "pantry": true },
    { "food": "太白粉", "label": "太白粉（勾芡）", "grams": 8, "track": "base", "pantry": true },
    { "food": "鮮香菇", "label": "鮮香菇（切小丁）", "grams": 100, "track": "veg" },
    { "food": "豬絞肉", "label": "豬絞肉", "grams": 150, "track": "meat" }
  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "板豆腐切塊，用鹽水（一小鍋水加一點鹽）汆燙一分鐘撈起瀝乾，比較不會碎；薑切末；香菇切小丁。" },
    { "stage": "base", "type": "cook", "text": "鍋中下油，小火把薑末和辣豆瓣醬炒出紅油，加醬油、糖和一碗水煮滾。" },
    { "stage": "split", "type": "split", "text": "把醬汁分成兩鍋：素食那鍋約三分之一，葷食那鍋約三分之二；豆腐也照比例分進去。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：加入香菇丁，中小火煮五分鐘讓豆腐吸味，用少許太白粉水勾薄芡即完成。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：另起小鍋把豬絞肉炒散炒白後倒入，中小火煮五分鐘，用太白粉水勾薄芡。" },
    { "stage": "meat", "type": "serve", "text": "兩鍋分別盛盤；喜歡的話葷食那盤可撒一點白胡椒粉。" }
  ]
}
