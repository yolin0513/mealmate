    {
      "stage": "base",
      "type": "cook",
      "text": "大鍋放 1500 毫升水、蓮藕與薑片，煮滾後轉小火煮十分鐘。"
    },
    {
      "stage": "split",
      "type": "split",
      "text": "把湯底分成兩鍋，素食那鍋依吃素的人數分。"
    },
    {
      "stage": "veg",
      "type": "cook",
      "text": "素食那鍋：加入香菇與泡菇水，小火煮二十分鐘，加鹽調味。"
    },
    {
      "stage": "meat",
      "type": "cook",
      "text": "葷食那鍋：加入汆燙好的排骨，小火煮三十五分鐘到排骨脫骨，加鹽調味。"
    }
