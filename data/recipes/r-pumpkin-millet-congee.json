  "id": "r-pumpkin-millet-congee",
  "name": "南瓜小米粥",
  "role": "breakfast",
  "servings": 4,
  "time": 35,
  "method": "porridge",
  "vegMode": "nativeVeg",
  "texture": "soft",
  "season": [],
  "includesStaple": true,
  "ingredients": [
    { "food": "小米", "label": "小米（生）", "grams": 100, "track": "base" },
    { "food": "白米", "label": "白米（生）", "grams": 100, "track": "base", "pantry": true },
    { "food": "南瓜", "label": "南瓜（去皮去籽切塊）", "grams": 300, "track": "base" },
    { "food": "鹽", "label": "鹽（少許，可省略）", "grams": 1, "track": "base", "pantry": true }
