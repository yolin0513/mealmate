  "steps": [
    { "stage": "base", "type": "prep", "text": "小米與白米一起洗淨；南瓜去皮去籽，切 2 公分塊。" },
    { "stage": "base", "type": "cook", "text": "鍋放米與 1700 毫升水煮滾，轉小火煮 15 分鐘，中途攪幾次免得黏鍋。" },
    { "stage": "base", "type": "cook", "text": "加入南瓜塊再煮 15 分鐘，到南瓜軟爛、用湯匙壓開拌進粥裡，喜歡鹹的加一點鹽。" }
  ]
}
