  "season": [],
  "includesStaple": true,
  "ingredients": [
    { "food": "白飯", "label": "白飯（溫的比較好捏）", "grams": 600, "track": "base", "pantry": true },
    { "food": "豆腐皮", "label": "豆皮（切小片）", "grams": 120, "track": "base" },
    { "food": "海苔", "label": "海苔片（4 張）", "grams": 8, "track": "base" },
    { "food": "白芝麻", "label": "熟白芝麻", "grams": 8, "track": "base", "pantry": true },
    { "food": "醬油", "label": "醬油", "grams": 15, "track": "base", "pantry": true },
