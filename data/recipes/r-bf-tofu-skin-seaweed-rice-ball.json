  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "豆皮切小片；白飯拌入白芝麻。" },
    { "stage": "base", "type": "cook", "text": "鍋熱下油，放豆皮煎到兩面微黃，加醬油、糖和 2 大匙水，煮到醬汁收乾。" },
    { "stage": "base", "type": "prep", "text": "保鮮膜上鋪一層飯壓平，放醬燒豆皮，再蓋一層飯，提起保鮮膜捏成三角形。" },
    { "stage": "base", "type": "serve", "text": "吃之前再包上海苔片，海苔才不會軟掉。" }
