    {
      "stage": "base",
      "type": "cook",
      "text": "大鍋放 1400 毫升水、芋頭與薑片，煮滾後小火煮十分鐘。"
    },
    {
      "stage": "split",
      "type": "split",
      "text": "把湯底分成兩鍋，素食那鍋依吃素的人數分。"
    },
    {
      "stage": "veg",
      "type": "cook",
      "text": "素食那鍋：加香菇片與一半油蔥酥，小火煮十五分鐘到芋頭鬆軟，加鹽。"
    },
    {
      "stage": "meat",
      "type": "cook",
      "text": "葷食那鍋：加排骨與剩下的油蔥酥，小火煮三十分鐘，加鹽。"
    }
