  "steps": [
    {
      "stage": "base",
      "type": "prep",
      "text": "馬鈴薯削皮切小丁；洋蔥切丁；玉米粒瀝乾，留三分之一最後放。"
    },
    {
      "stage": "base",
      "type": "cook",
      "text": "鍋中下油炒洋蔥到透明，加馬鈴薯與 700 毫升水，煮滾後小火煮十五分鐘到馬鈴薯鬆軟。"
    },
    {
      "stage": "base",
      "type": "cook",
      "text": "加三分之二的玉米粒，用湯匙壓碎馬鈴薯讓湯變濃（不用打成泥也可以）。"
    },
    {
      "stage": "base",
      "type": "cook",
      "text": "倒入鮮乳與剩下的玉米粒，小火加熱到冒小泡就關火，加鹽。牛奶不要煮滾才不會結塊。"
    }
  ]
