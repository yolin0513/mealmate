{
  "id": "r-beef-curry-split",
  "name": "咖哩牛肋條／咖哩鴻喜菇",
  "role": "main",
  "servings": 4,
  "splitServings": { "veg": 1, "meat": 3 },
  "time": 50,
  "method": "braise",
  "vegMode": "splittable",
  "texture": "soft",
  "season": [],
  "ingredients": [
    { "food": "洋蔥", "label": "洋蔥（切絲）", "grams": 250, "track": "base" },
    { "food": "胡蘿蔔", "label": "胡蘿蔔（切塊）", "grams": 180, "track": "base" },
    { "food": "馬鈴薯", "label": "馬鈴薯（切塊）", "grams": 350, "track": "base" },
    { "food": "咖哩塊", "label": "咖哩塊", "grams": 90, "track": "base", "pantry": true },
    { "food": "油", "label": "沙拉油", "grams": 15, "track": "base", "pantry": true },
    { "food": "鴻喜菇", "label": "鴻喜菇（剝小朵）", "grams": 200, "track": "veg" },
    { "food": "牛肋條", "label": "牛肋條（切 4 公分段）", "grams": 500, "track": "meat" }
  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "洋蔥切絲，胡蘿蔔、馬鈴薯切塊；鴻喜菇剝小朵；牛肋條切 4 公分段。" },
    { "stage": "base", "type": "cook", "text": "深鍋下油，洋蔥中火炒到微黃，加胡蘿蔔、馬鈴薯略炒，加水到剛好蓋過，煮滾後小火煮 15 分鐘。" },
    { "stage": "split", "type": "split", "text": "把蔬菜湯底分成兩鍋，素食那鍋依吃素的人數分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：放入鴻喜菇與四分之一的咖哩塊，小火攪到咖哩溶化變稠，再煮 5 分鐘。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：牛肋條先在平底鍋煎到表面焦香再加入，小火燉 25 分鐘，放剩下的咖哩塊煮到濃稠。" }
  ]
}
