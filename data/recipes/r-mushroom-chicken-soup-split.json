  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "乾香菇泡軟（泡菇水留著）；薑切片；白蘿蔔切塊；雞腿塊用滾水汆燙一分鐘洗淨。" },
    { "stage": "base", "type": "cook", "text": "大鍋放 1500 毫升水加泡菇水、香菇、薑片，煮滾。" },
    { "stage": "split", "type": "split", "text": "湯底分成兩鍋，素食那鍋依吃素的人數分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：放白蘿蔔塊小火煮 20 分鐘到透明，加枸杞與鹽。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：放雞腿塊小火煮 35 分鐘，加枸杞與鹽。" }
  ]
