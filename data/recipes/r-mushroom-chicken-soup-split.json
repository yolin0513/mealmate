    { "food": "乾香菇", "label": "乾香菇（泡軟）", "grams": 25, "track": "base" },
    { "food": "薑", "label": "薑片", "grams": 15, "track": "base" },
    { "food": "枸杞", "label": "枸杞", "grams": 8, "track": "base", "pantry": true },
    { "food": "鹽", "label": "鹽", "grams": 5, "track": "base", "pantry": true },
    { "food": "白蘿蔔", "label": "白蘿蔔（切塊）", "grams": 300, "track": "veg" },
