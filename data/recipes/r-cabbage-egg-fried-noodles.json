  "steps": [
    { "stage": "base", "type": "prep", "text": "高麗菜、胡蘿蔔切絲，蔥切段；蛋打散。" },
    { "stage": "base", "type": "cook", "text": "麵條下滾水煮到比包裝時間少 1 分鐘，撈起瀝乾，拌一點油防黏。" },
    { "stage": "base", "type": "cook", "text": "鍋熱下油，倒入蛋液炒散盛起；再下胡蘿蔔、高麗菜炒到變軟。" },
