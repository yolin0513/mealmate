  "steps": [
    { "stage": "base", "type": "prep", "text": "米洗淨；胡蘿蔔切小丁、高麗菜切細絲、薑切絲；雞蛋打散。" },
    { "stage": "base", "type": "cook", "text": "鍋放米、薑絲和 1500 毫升水，煮滾後轉小火，蓋鍋留一點縫煮 25 分鐘，中途攪幾次以免黏底。" },
    { "stage": "base", "type": "cook", "text": "加入胡蘿蔔丁和高麗菜絲再煮五分鐘到蔬菜軟。" },
