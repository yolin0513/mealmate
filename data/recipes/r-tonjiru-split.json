    { "food": "胡蘿蔔", "label": "胡蘿蔔（切扇形薄片）", "grams": 100, "track": "base" },
    { "food": "牛蒡", "label": "牛蒡（削薄片）", "grams": 80, "track": "base" },
    { "food": "青蔥", "label": "蔥花", "grams": 20, "track": "base" },
