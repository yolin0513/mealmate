  "steps": [
    { "stage": "base", "type": "prep", "text": "白蘿蔔、胡蘿蔔切扇形薄片，牛蒡削薄片泡水；油豆腐切片；豬五花切段。" },
    { "stage": "base", "type": "cook", "text": "鍋放 1200 毫升水與根菜煮滾，轉小火煮 10 分鐘到蘿蔔變透明。" },
    { "stage": "split", "type": "split", "text": "把根菜湯分成兩鍋，素食那鍋依吃素的人數分，味噌也照同樣比例分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：放油豆腐煮 3 分鐘，味噌用一勺熱湯化開倒回，關火撒蔥花，不要再煮滾。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：五花肉片先用麻油炒到變色再加進湯裡煮 5 分鐘，撈掉浮沫，味噌化開倒回，關火撒蔥花。" }
  ]
