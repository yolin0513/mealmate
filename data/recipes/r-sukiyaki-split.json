  "steps": [
    { "stage": "base", "type": "prep", "text": "大白菜切大片、洋蔥切絲、金針菇切去根部、青蔥切段；豆腐切厚片。" },
    { "stage": "base", "type": "cook", "text": "淺鍋放醬油、味醂、糖與 300 毫升水煮滾成醬汁，放洋蔥、大白菜、金針菇與蔥段煮 5 分鐘到軟。" },
    { "stage": "split", "type": "split", "text": "把蔬菜連醬汁分成兩鍋，素食那鍋依吃素的人數分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：放入豆腐片，小火煮 5 分鐘讓豆腐吸飽醬汁。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：牛肉片一片片攤開放在蔬菜上，涮到變色就關火，不要煮老。" }
