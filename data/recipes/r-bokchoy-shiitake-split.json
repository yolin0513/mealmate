    {
      "stage": "base",
      "type": "prep",
      "text": "青江菜切段，梗葉分開；鮮香菇切片；乾香菇泡軟切絲；肉切絲用醬油抓醃五分鐘。"
    },
    {
      "stage": "base",
      "type": "cook",
      "text": "熱鍋下油爆香薑絲，下鮮香菇炒香，再下青江菜梗炒兩分鐘。"
    },
    {
      "stage": "base",
      "type": "cook",
      "text": "下青江菜葉炒到全部變軟，加鹽拌勻。"
    },
    {
      "stage": "split",
      "type": "split",
      "text": "先盛出素食成員要吃的份量到另一個鍋子（依吃素的人數分）。"
    },
    {
      "stage": "veg",
      "type": "cook",
      "text": "素食那鍋：加入泡軟的乾香菇絲與兩大匙泡菇水，再炒一分鐘。"
    },
    {
      "stage": "meat",
      "type": "cook",
      "text": "葷食那鍋：加入醃過的肉絲，炒到肉全部變白就起鍋。"
    }
  ]
