  "steps": [
    { "stage": "base", "type": "prep", "text": "蝦仁退冰吸乾，用一點鹽和白胡椒粉抓一下；雞蛋打散加鹽；蔥切蔥花。" },
    { "stage": "base", "type": "cook", "text": "鍋下一半的油，蝦仁中火炒到變紅捲起，先盛出。" },
