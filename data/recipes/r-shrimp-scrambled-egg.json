  "ingredients": [
    { "food": "蝦仁", "label": "蝦仁", "grams": 200, "track": "base" },
    { "food": "雞蛋", "label": "雞蛋", "grams": 220, "track": "base" },
    { "food": "青蔥", "label": "青蔥（切蔥花，可省略）", "grams": 15, "track": "base" },
