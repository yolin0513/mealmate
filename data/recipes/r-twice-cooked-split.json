  "steps": [
    { "stage": "base", "type": "prep", "text": "高麗菜撕大片；青蒜斜切段；豆干切片；五花肉切薄片。" },
    { "stage": "base", "type": "cook", "text": "鍋下一半的油，高麗菜大火炒到微軟先盛起；同鍋小火把辣豆瓣醬炒出紅油，加醬油、糖。" },
    { "stage": "split", "type": "split", "text": "醬料分成兩鍋，素食那鍋依吃素的人數分；高麗菜與青蒜也照比例分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：下豆干片炒到表面微焦，倒回高麗菜與青蒜翻炒均勻。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：五花肉片先炒到出油微焦，再與醬料、高麗菜、青蒜一起翻炒到裹上醬色。" }
