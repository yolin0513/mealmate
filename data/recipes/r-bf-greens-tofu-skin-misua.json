  "steps": [
    { "stage": "base", "type": "prep", "text": "小白菜洗淨切段、香菇切片、豆皮切條。" },
    { "stage": "base", "type": "cook", "text": "一鍋水煮滾，下麵線煮 2 分鐘，撈起用冷水沖一下去掉多的鹹味，分到碗裡。" },
    { "stage": "base", "type": "cook", "text": "另一鍋加 1200 毫升水煮滾，下香菇、豆皮煮 3 分鐘，再下小白菜煮到軟，加醬油、鹽、白胡椒粉調味。" },
    { "stage": "base", "type": "serve", "text": "把湯和料淋到麵線上，滴幾滴香油。" }
  ]
