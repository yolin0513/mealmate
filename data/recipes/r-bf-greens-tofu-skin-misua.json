  "ingredients": [
    { "food": "麵線", "label": "麵線", "grams": 200, "track": "base" },
    { "food": "豆腐皮", "label": "豆皮（切條）", "grams": 120, "track": "base" },
    { "food": "小白菜", "label": "小白菜（切段）", "grams": 200, "track": "base" },
    { "food": "香菇", "label": "新鮮香菇（切片）", "grams": 80, "track": "base" },
    { "food": "醬油", "label": "醬油", "grams": 15, "track": "base", "pantry": true },
    { "food": "鹽", "label": "鹽", "grams": 2, "track": "base", "pantry": true },
