  "steps": [
    { "stage": "base", "type": "prep", "text": "馬鈴薯切薄片，放進電鍋外鍋半杯水蒸到筷子穿得過；洋蔥切絲、洋菇切片；雞蛋打散加鮮奶、鹽、黑胡椒拌勻。" },
