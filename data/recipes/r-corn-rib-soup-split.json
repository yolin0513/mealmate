  "steps": [
    { "stage": "base", "type": "prep", "text": "玉米切段、胡蘿蔔切塊、薑切片；乾香菇泡軟；排骨用滾水汆燙兩分鐘洗去血水。" },
    { "stage": "base", "type": "cook", "text": "大鍋放 1500 毫升水、玉米、胡蘿蔔、薑片，煮滾。" },
