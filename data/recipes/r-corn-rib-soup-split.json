    { "stage": "veg", "type": "cook", "text": "素食那鍋：加入香菇與泡菇水，小火煮 20 分鐘，加鹽調味。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：加入汆燙過的排骨，小火煮 40 分鐘到排骨軟，加鹽調味。" }
