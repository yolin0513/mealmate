{
  "id": "r-century-egg-congee-split",
  "name": "皮蛋瘦肉粥／皮蛋香菇粥",
  "role": "breakfast",
  "servings": 4,
  "splitServings": { "veg": 1, "meat": 3 },
  "time": 40,
  "method": "porridge",
  "vegMode": "splittable",
  "texture": "soft",
  "season": [],
  "alliumOptional": true,
  "ingredients": [
    { "food": "白米", "label": "白米（生）", "grams": 160, "track": "base", "pantry": true },
    { "food": "皮蛋", "label": "皮蛋（2 顆，切丁）", "grams": 92, "track": "base" },
    { "food": "薑", "label": "薑絲", "grams": 10, "track": "base" },
    { "food": "鹽", "label": "鹽", "grams": 4, "track": "base", "pantry": true },
    { "food": "香油", "label": "香油", "grams": 5, "track": "base", "pantry": true },
    { "food": "青蔥", "label": "青蔥（切蔥花，可省略）", "grams": 10, "track": "base" },
    { "food": "鮮香菇", "label": "鮮香菇（切片）", "grams": 80, "track": "veg" },
    { "food": "豬肉片", "label": "豬肉絲", "grams": 150, "track": "meat" }
  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "米洗淨；皮蛋切丁；薑切絲、蔥切蔥花；香菇切片；豬肉切絲用一點鹽抓一下。" },
    { "stage": "base", "type": "cook", "text": "鍋放米、薑絲與 1500 毫升水，煮滾後小火煮 25 分鐘成粥底，中途攪幾次。" },
    { "stage": "split", "type": "split", "text": "粥底分成兩鍋，素食那鍋依吃素的人數分；皮蛋丁也照比例分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：下香菇片與皮蛋丁煮 5 分鐘，加鹽、淋香油、撒蔥花。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：下肉絲與皮蛋丁煮到肉變白，加鹽、淋香油、撒蔥花。" }
  ]
}
