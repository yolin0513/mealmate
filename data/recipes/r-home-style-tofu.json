{
  "id": "r-home-style-tofu",
  "name": "家常煎豆腐",
  "role": "main",
  "servings": 4,
  "time": 20,
  "method": "pan",
  "vegMode": "nativeVeg",
  "texture": "soft",
  "season": [],
  "alliumOptional": true,
  "ingredients": [
    { "food": "板豆腐", "label": "板豆腐（切厚片）", "grams": 600, "track": "base" },
    { "food": "青蔥", "label": "青蔥（可省略）", "grams": 20, "track": "base" },
    { "food": "醬油", "label": "醬油", "grams": 20, "track": "base", "pantry": true },
    { "food": "糖", "label": "糖", "grams": 4, "track": "base", "pantry": true },
    { "food": "油", "label": "沙拉油", "grams": 20, "track": "base", "pantry": true },
    { "food": "太白粉", "label": "太白粉（勾芡）", "grams": 5, "track": "base", "pantry": true }
  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "豆腐切 1.5 公分厚片，用紙巾吸乾；青蔥切段，蔥白蔥綠分開。" },
    { "stage": "base", "type": "cook", "text": "平底鍋下油，豆腐排入中火煎到兩面金黃。" },
    { "stage": "base", "type": "cook", "text": "下蔥白，加醬油、糖和半碗水，煮兩分鐘讓豆腐吸味。" },
    { "stage": "base", "type": "serve", "text": "用太白粉水勾薄芡，撒蔥綠起鍋。" }
  ]
}
