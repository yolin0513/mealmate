  "season": [5, 6, 7, 8, 9],
  "ingredients": [
    { "food": "大黃瓜", "label": "大黃瓜（去皮去籽切塊）", "grams": 500, "track": "base" },
    { "food": "薑", "label": "薑片", "grams": 10, "track": "base" },
    { "food": "鹽", "label": "鹽", "grams": 5, "track": "base", "pantry": true },
    { "food": "乾香菇", "label": "乾香菇（泡軟）", "grams": 20, "track": "veg" },
    { "food": "豬小排", "label": "豬小排", "grams": 400, "track": "meat" }
  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "大黃瓜去皮、挖掉籽切塊，薑切片；乾香菇泡軟；排骨用滾水汆燙兩分鐘洗去血水。" },
    { "stage": "base", "type": "cook", "text": "大鍋放 1500 毫升水與薑片煮滾。" },
    { "stage": "split", "type": "split", "text": "把湯底分成兩鍋，素食那鍋依吃素的人數分，大黃瓜也照比例分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：放香菇與泡菇水煮 10 分鐘，再下大黃瓜煮 15 分鐘到透明，加鹽調味。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：放排骨小火煮 25 分鐘，再下大黃瓜煮 15 分鐘到透明，加鹽調味。" }
  ]
