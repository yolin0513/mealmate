  "steps": [
    {
      "stage": "base",
      "type": "prep",
      "text": "芥藍菜切段，梗葉分開，梗較粗的斜切；杏鮑菇切片；牛肉片備好。"
    },
    {
      "stage": "base",
      "type": "cook",
      "text": "滾水加一小匙鹽，芥藍梗燙一分鐘、葉子燙三十秒，撈起瀝乾（先燙過顏色比較綠、也去掉一點苦味）。"
    },
    {
      "stage": "base",
      "type": "cook",
      "text": "熱鍋下油爆香薑片，下芥藍炒勻，加鹽。"
    },
    {
      "stage": "split",
      "type": "split",
      "text": "先盛出素食成員要吃的份量（依吃素的人數分）。"
    },
    {
      "stage": "veg",
      "type": "cook",
      "text": "素食那鍋：下杏鮑菇片與醬油炒到菇軟。蠔油含蠔汁，素食這鍋不放。"
    },
    {
      "stage": "meat",
      "type": "cook",
      "text": "葷食那鍋：下牛肉片大火炒到變色，加蠔油拌勻起鍋。"
    }
  ]
}
