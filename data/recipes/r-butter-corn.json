  "ingredients": [
    { "food": "玉米粒", "label": "冷凍玉米粒", "grams": 400, "track": "base" },
    { "food": "甜椒", "label": "紅甜椒（切小丁）", "grams": 60, "track": "base" },
    { "food": "奶油", "label": "奶油", "grams": 20, "track": "base", "pantry": true },
