    { "food": "胡蘿蔔", "label": "胡蘿蔔（切絲）", "grams": 60, "track": "base" },
    { "food": "乾香菇", "label": "乾香菇（泡軟切絲）", "grams": 15, "track": "base" },
    { "food": "醬油", "label": "醬油", "grams": 30, "track": "base", "pantry": true },
    { "food": "油", "label": "沙拉油", "grams": 25, "track": "base", "pantry": true },
    { "food": "鹽", "label": "鹽", "grams": 3, "track": "base", "pantry": true },
    { "food": "白胡椒粉", "label": "白胡椒粉", "grams": 1, "track": "base", "pantry": true },
