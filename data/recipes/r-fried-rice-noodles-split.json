  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "米粉泡溫水 5 分鐘軟化後剪短瀝乾；高麗菜、胡蘿蔔切絲；乾香菇泡軟切絲（泡菇水留著）。" },
    { "stage": "base", "type": "cook", "text": "鍋下油炒香香菇絲，下胡蘿蔔與高麗菜炒軟，加醬油、鹽、白胡椒粉與一碗泡菇水煮滾。" },
    { "stage": "split", "type": "split", "text": "把菜與湯汁分成兩鍋，素食那鍋依吃素的人數分；米粉也照比例分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：下豆干絲與米粉，用筷子翻拌到湯汁被米粉吸乾。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：先炒香蝦米與豬肉絲，再倒回菜料與米粉翻拌到收乾。" }
  ]
