{
  "id": "r-kimchi-pork",
  "name": "泡菜炒豬肉",
  "role": "main",
  "servings": 4,
  "time": 20,
  "method": "stirfry",
  "vegMode": "meatOnly",
  "texture": "normal",
  "season": [],
  "notes": "市售韓式泡菜多半加了魚露或蝦醬，所以不做素版。",
  "ingredients": [
    { "food": "梅花肉", "label": "梅花豬肉片", "grams": 400, "track": "base" },
    { "food": "韓式泡菜", "label": "韓式泡菜（切段）", "grams": 250, "track": "base" },
    { "food": "洋蔥", "label": "洋蔥（切絲）", "grams": 150, "track": "base" },
    { "food": "青蔥", "label": "青蔥（切段）", "grams": 20, "track": "base" },
    { "food": "醬油", "label": "醬油", "grams": 10, "track": "base", "pantry": true },
    { "food": "糖", "label": "糖", "grams": 4, "track": "base", "pantry": true },
    { "food": "麻油", "label": "麻油", "grams": 5, "track": "base", "pantry": true },
    { "food": "油", "label": "沙拉油", "grams": 10, "track": "base", "pantry": true }
