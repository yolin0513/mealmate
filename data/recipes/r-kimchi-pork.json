  "steps": [
    { "stage": "base", "type": "prep", "text": "泡菜切段、保留湯汁；洋蔥切絲、青蔥切段。" },
    { "stage": "base", "type": "cook", "text": "鍋下油，梅花肉片大火炒到出油、邊緣微焦。" },
    { "stage": "base", "type": "cook", "text": "加洋蔥炒軟，下泡菜連湯汁、醬油與糖，翻炒 3 分鐘到湯汁收乾。" },
    { "stage": "base", "type": "cook", "text": "放蔥段，淋麻油拌勻就起鍋。" }
