  "steps": [
    { "stage": "base", "type": "prep", "text": "豆腐切塊；鴻喜菇撕小朵、香菇切片、金針菇切段；胡蘿蔔切薄片；薑切片。" },
    { "stage": "base", "type": "cook", "text": "砂鍋或深鍋下油爆香薑片，下所有菇類與胡蘿蔔炒到菇出水變軟。" },
    { "stage": "base", "type": "cook", "text": "加醬油和一碗水，放入豆腐，蓋鍋中小火煮八分鐘。" },
    { "stage": "base", "type": "serve", "text": "太白粉水勾薄芡，淋香油，整鍋上桌。" }
  ]
