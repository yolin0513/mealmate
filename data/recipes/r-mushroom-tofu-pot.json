  "ingredients": [
    { "food": "板豆腐", "label": "板豆腐（切塊）", "grams": 450, "track": "base" },
    { "food": "鴻喜菇", "label": "鴻喜菇", "grams": 150, "track": "base" },
    { "food": "鮮香菇", "label": "鮮香菇（切片）", "grams": 100, "track": "base" },
    { "food": "金針菇", "label": "金針菇", "grams": 100, "track": "base" },
    { "food": "胡蘿蔔", "label": "胡蘿蔔（切片）", "grams": 60, "track": "base" },
    { "food": "薑", "label": "薑片", "grams": 10, "track": "base" },
    { "food": "醬油", "label": "醬油", "grams": 20, "track": "base", "pantry": true },
    { "food": "香油", "label": "香油", "grams": 5, "track": "base", "pantry": true },
    { "food": "油", "label": "沙拉油", "grams": 15, "track": "base", "pantry": true },
