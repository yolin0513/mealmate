    { "food": "乾香菇", "label": "乾香菇（泡軟切絲）", "grams": 15, "track": "base" },
    { "food": "雞蛋", "label": "雞蛋（1 顆）", "grams": 50, "track": "base" },
    { "food": "青蔥", "label": "蔥末", "grams": 20, "track": "base" },
    { "food": "薑", "label": "薑末", "grams": 10, "track": "base" },
