  "steps": [
    { "stage": "base", "type": "prep", "text": "乾香菇泡軟切絲（泡菇水留著）；絞肉加蔥末、薑末、雞蛋、一半的醬油與太白粉，朝同一方向攪到有黏性，捏成 8 顆大肉丸。" },
    { "stage": "base", "type": "cook", "text": "鍋下油，肉丸中小火兩面煎到定型金黃。" },
    { "stage": "base", "type": "cook", "text": "砂鍋底鋪大白菜與香菇絲，放上肉丸，加剩下的醬油、糖、泡菇水與 400 毫升水。" },
    { "stage": "base", "type": "cook", "text": "煮滾後轉小火蓋鍋燉 30 分鐘，到白菜軟爛、肉丸入味。" }
