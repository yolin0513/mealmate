  "steps": [
    {
      "stage": "base",
      "type": "prep",
      "text": "洋蔥切丁；馬鈴薯、胡蘿蔔切塊；腰果乾鍋小火烘香備用；豆腐與雞腿分別切塊。"
    },
    {
      "stage": "base",
      "type": "cook",
      "text": "鍋中下油炒洋蔥到金黃，加咖哩粉炒三十秒出香味。"
    },
    {
      "stage": "base",
      "type": "cook",
      "text": "下馬鈴薯與胡蘿蔔炒勻，加 500 毫升水煮滾後小火煮十分鐘。"
    },
    {
      "stage": "split",
      "type": "split",
      "text": "分成兩鍋，素食那鍋依吃素的人數分。"
    },
    {
      "stage": "veg",
      "type": "cook",
      "text": "素食那鍋：加豆腐塊煮十分鐘，加鹽，起鍋前撒一半腰果。"
    },
    {
      "stage": "meat",
      "type": "cook",
      "text": "葷食那鍋：加雞腿塊煮十五分鐘到雞肉熟透，加鹽，起鍋前撒剩下的腰果。"
    }
  ]
