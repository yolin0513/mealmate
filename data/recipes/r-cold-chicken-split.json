{
  "id": "r-cold-chicken-split",
  "name": "涼拌雞絲／涼拌豆干絲",
  "role": "main",
  "servings": 4,
  "splitServings": { "veg": 1, "meat": 3 },
  "time": 25,
  "method": "cold",
  "vegMode": "splittable",
