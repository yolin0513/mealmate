  "steps": [
    { "stage": "base", "type": "prep", "text": "麵粉加 300 毫升水與鹽攪成沒有顆粒的麵糊，靜置 10 分鐘；高麗菜切細絲、蔥切蔥花，拌進麵糊。" },
