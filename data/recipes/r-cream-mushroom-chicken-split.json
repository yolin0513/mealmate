{
  "id": "r-cream-mushroom-chicken-split",
  "name": "奶油洋菇燉雞／奶油洋菇燉鴻喜菇",
  "role": "main",
  "servings": 4,
  "splitServings": { "veg": 1, "meat": 3 },
  "time": 40,
  "method": "braise",
  "vegMode": "splittable",
  "texture": "soft",
  "season": [],
  "ingredients": [
    { "food": "洋蔥", "label": "洋蔥（切丁）", "grams": 200, "track": "base" },
    { "food": "洋菇", "label": "洋菇（切片）", "grams": 250, "track": "base" },
    { "food": "胡蘿蔔", "label": "胡蘿蔔（切丁）", "grams": 120, "track": "base" },
    { "food": "馬鈴薯", "label": "馬鈴薯（切塊）", "grams": 300, "track": "base" },
    { "food": "鮮奶", "label": "鮮奶", "grams": 400, "track": "base" },
    { "food": "奶油", "label": "奶油", "grams": 30, "track": "base", "pantry": true },
    { "food": "麵粉", "label": "麵粉", "grams": 30, "track": "base", "pantry": true },
    { "food": "鹽", "label": "鹽", "grams": 5, "track": "base", "pantry": true },
    { "food": "黑胡椒粉", "label": "黑胡椒粉", "grams": 1, "track": "base", "pantry": true },
    { "food": "鴻喜菇", "label": "鴻喜菇（剝小朵）", "grams": 150, "track": "veg" },
    { "food": "去骨雞腿", "label": "去骨雞腿肉（切塊）", "grams": 500, "track": "meat" }
  ],
  "steps": [
    { "stage": "base", "type": "prep", "text": "洋蔥、胡蘿蔔切丁，洋菇切片，馬鈴薯切塊；鴻喜菇剝小朵；雞腿肉切一口大小。" },
    { "stage": "base", "type": "cook", "text": "鍋放奶油融化，洋蔥炒軟，加洋菇炒到出水，撒麵粉炒 1 分鐘，慢慢加入 500 毫升水攪勻，放胡蘿蔔與馬鈴薯小火煮 15 分鐘。" },
    { "stage": "split", "type": "split", "text": "把白醬蔬菜湯底分成兩鍋，素食那鍋依吃素的人數分，鮮奶也照同樣比例分。" },
    { "stage": "veg", "type": "cook", "text": "素食那鍋：放入鴻喜菇與分到的鮮奶，小火煮 5 分鐘到濃稠，加鹽與黑胡椒調味。" },
    { "stage": "meat", "type": "cook", "text": "葷食那鍋：雞腿肉先在平底鍋煎到表面金黃再加入，倒入其餘鮮奶，小火煮 10 分鐘到雞肉熟透，加鹽與黑胡椒調味。" }
  ]
}
