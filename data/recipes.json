ep","text":"小黃瓜洗淨拍裂後切段，撒鹽抓一下靜置十分鐘，倒掉出的水。"},{"stage":"base","type":"prep","text":"蒜切末，和白醋、糖、香油調成醬汁。"},{"stage":"base","type":"serve","text":"醬汁倒進小黃瓜拌勻，冰十分鐘更脆。"}],"tags":["allium"],"proteins":[],"source":"builtin"},{"id":"r-corn-rib-soup-split","name":"玉米排骨湯／玉米香菇湯","role":"soup","servings":4,"time":50,"method":"soup","vegMode":"splittable","texture":"soft","season":[],"ingredients":[{"food":"A0400301","label":"甜玉米（切段）","grams":400,"track":"base"},{"food":"E0200101","label":"胡蘿蔔（切塊）","grams":150,"track":"base"},{"food":"E1900103","label":"薑片","grams":10,"track":"base"},{"food":"P0300101","label":"鹽","grams":5,"track":"base","pantry":true},{"food":"G08101","label":"乾香菇（泡軟）","grams":20,"track":"veg"},{"food":"I0304301","label":"豬小排","grams":400,"track":"meat"}],"steps":[{"stage":"base","type":"prep","text":"玉米切段、胡蘿蔔切塊、薑切片；乾香菇泡軟；排骨用滾水汆燙兩分鐘洗去血水。"},{"stage":"base","type":"cook","text":"大鍋放 1500 毫升水、玉米、胡蘿蔔、薑片，煮滾。"},{"stage":"split","type":"split","text":"把湯底分成兩鍋，素食那鍋約三分之一。"},{"stage":"veg","type":"cook","text":"素食那鍋：加入香菇與泡菇水，小火煮 20 分鐘，加鹽調味。"},{"stage":"meat","type":"cook","text":"葷食那鍋：加入汆燙過的排骨，小火煮 40 分鐘到排骨軟，加鹽調味。"}],"tags":["meat"],"proteins":["pork"],"source":"builtin"},{"id":"r-curry-split","name":"家常咖哩（可分素葷）","role":"main","servings":4,"time":40,"method":"braise","vegMode":"splittable","texture":"soft","season":[],"ingredients":[{"food":"B0700201","label":"馬鈴薯（切塊）","grams":360,"track":"base"},{"food":"E0200101","label":"胡蘿蔔（切塊）","grams":190,"track":"base"},{"food":"E2400301","label":"洋蔥（切絲）","grams":250,"track":"base"},{"food":"P0200501","label":"咖哩塊","grams":90,"track":"base","pantry":true},{"food":"M1100101","label":"沙拉油","grams":15,"track":"base","pantry":true},{"food":"R4700901","label":"板豆腐（切大塊）","grams":300,"track":"veg"},{"food":"I0404501","label":"去骨雞腿肉（切塊）","grams":400,"track":"meat"}],"steps":[{"stage":"base","type":"prep","text":"馬鈴薯、胡蘿蔔切 3 公分塊，洋蔥切絲；豆腐切大塊；雞腿肉切一口大小。"},{"stage":"base","type":"cook","text":"深鍋下油，洋蔥中火炒到透明微黃，加入馬鈴薯和胡蘿蔔略炒，加水到剛好蓋過食材，煮滾後轉小火煮 15 分鐘。"},{"